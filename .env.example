# 复制为 .env 后按需修改。.env 不进仓库（含密钥）。
# 迭代 0 不需要改任何一项，直接复制即可。

# 数据目录：数据库、备份、日志都放这里。相对路径相对于项目文件夹。
# Windows 上默认 data（项目里的 data 文件夹）；树莓派上是 /opt/documentary/data
DATA_DIR=data

# 境外接口（TMDB、IMDb、YouTube）走的代理，国内网站直连。迭代 1 起用到。
# 你电脑上的本地代理是 127.0.0.1:10808；如果它是 socks 端口，写成 socks5://127.0.0.1:10808
PROXY_URL=http://127.0.0.1:10808

# 网页地址。Windows 上只允许本机访问；树莓派上改成 0.0.0.0（局域网和 Tailscale 可访问）
WEB_HOST=127.0.0.1
WEB_PORT=8000

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# —— 密钥（迭代 1 起逐个加入）——
# TMDB_API_KEY=
